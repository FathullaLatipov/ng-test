# Пароль админки. ОБЯЗАТЕЛЬНО задайте свой длинный пароль (на Vercel без него вход в админку отключён).
ADMIN_PASSWORD=

# Заявки с сайта → Telegram-канал (токен берётся у @BotFather; chat id канала вида -100...)
# Бот должен быть администратором канала. НИКОГДА не коммитьте реальные значения.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет webhook для кнопок статуса (любая длинная случайная строка: буквы, цифры, _ и -)
TELEGRAM_WEBHOOK_SECRET=

# Для Vercel: бесплатный Upstash Redis
# Создайте БД на https://console.upstash.com → REST API → скопируйте:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
